###############################################################################
# Paperless-ngx settings (EJEMPLO — sin secretos reales)                     #
###############################################################################

# See http://docs.paperless-ngx.com/configuration/ for all available options.

# The UID and GID of the user used to run paperless in the container. Set this
# to your UID and GID on the host so that you have write access to the
# consumption directory.
#USERMAP_UID=1000
#USERMAP_GID=1000

# This is required if you will be exposing Paperless-ngx on a public domain
# (if doing so please consider security measures such as reverse proxy)
PAPERLESS_URL=http://localhost:9000

# Required. A unique secret key for session tokens and signing.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=replace-with-a-real-secret-key

PAPERLESS_DEBUG=false
PAPERLESS_ACCOUNT_DEFAULT_HTTP_PROTOCOL=http

# Use this variable to set a timezone for the Paperless Docker containers. Defaults to UTC.
#PAPERLESS_TIME_ZONE=America/Los_Angeles

# The default language to use for OCR. Set this to the language most of your
# documents are written in.
#PAPERLESS_OCR_LANGUAGE=eng

# Additional languages to install for text recognition, separated by a whitespace.
# The container installs English, German, Italian, Spanish and French by default.
# See https://packages.debian.org/search?keywords=tesseract-ocr-&searchon=names
#PAPERLESS_OCR_LANGUAGES=tur ces

# SMTP — Gmail
PAPERLESS_EMAIL_HOST=smtp.gmail.com
PAPERLESS_EMAIL_PORT=587
PAPERLESS_EMAIL_USE_TLS=true
PAPERLESS_EMAIL_HOST_USER=your-email@gmail.com
PAPERLESS_EMAIL_HOST_PASSWORD=your-app-password

# OAuth — Google y Microsoft (allauth)
PAPERLESS_APPS=allauth.socialaccount.providers.google,allauth.socialaccount.providers.microsoft
PAPERLESS_SOCIALACCOUNT_PROVIDERS={"google":{"APPS":[{"provider_id":"google","name":"Google","client_id":"your-google-client-id","secret":"your-google-secret"}]},"microsoft":{"APPS":[{"provider_id":"microsoft","name":"Microsoft","client_id":"your-microsoft-client-id","secret":"your-microsoft-secret","settings":{"tenant":"your-tenant-id"}}]}}

# OAuth — Discord (custom app paperless_discord)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_AUTH_URL=https://discord.com/oauth2/authorize
DISCORD_API_URL=https://discord.com/api

###############################################################################
# Deployment compose settings (used by docker-compose.deploy.yml)             #
###############################################################################

# === CAMBIA ESTAS 3 VARIABLES ANTES DE DESPLEGAR ===
# PAPERLESS_SECRET_KEY  (arriba en este mismo archivo)
PAPERLESS_WEB_PORT=9000          # Puerto del host — verifica que esté libre

# === Resto (normalmente no se toca) ===
COMPOSE_PROJECT_NAME=paperless-ngx

PAPERLESS_POSTGRES_DB=paperless
PAPERLESS_POSTGRES_USER=paperless
PAPERLESS_POSTGRES_PORT=5432
PAPERLESS_POSTGRES_PASSWORD=paperless

# Documenso integration
PAPERLESS_DOCUMENSO_URL=https://documenso.com
PAPERLESS_DOCUMENSO_TOKEN=api_182baxxxxxxxxxx